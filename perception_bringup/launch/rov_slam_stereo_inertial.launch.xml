<launch>
  <arg name="param_dir" default="$(find-pkg-share perception_bringup)/config/"/>
  <arg name="camera_file" default="camera.yaml"/>
  <arg name="imu_file" default="imu.yaml"/>
  <arg name="orb_slam3_file" default="orb_slam3.yaml"/>
  <arg name="mask_dir" default="$(var param_dir)/mask"/>
  <arg name="vocabulary_dir" default="$(find-pkg-share rov_slam)/vocabulary"/>
  <arg name="vocabulary_file" default="ORBvoc.txt"/>
  <arg name="use_sim" default="false"/>

  <arg name="left_image_topic" default="/corrected/left/image_raw"/>
  <arg name="right_image_topic" default="/corrected/right/image_raw"/>
  <arg name="imu_topic" default="/camera/imu"/>

  <node pkg="rov_slam" exec="stereo-inertial" name="orb_slam3" output="screen">
    <param from="$(var param_dir)/$(var camera_file)"/>
    <param from="$(var param_dir)/$(var imu_file)"/>
    <param from="$(var param_dir)/$(var orb_slam3_file)"/>
    <param name="slam.vocabulary_file" value="$(var vocabulary_dir)/$(var vocabulary_file)"/>
    <param name="slam.mask_dir" value="$(var mask_dir)"/>
    <param name="use_sim_time" value="$(var use_sim)"/>
    <remap from="camera/left" to="$(var left_image_topic)"/>
    <remap from="camera/right" to="$(var right_image_topic)"/>
    <remap from="imu" to="$(var imu_topic)"/>
  </node>
</launch>
