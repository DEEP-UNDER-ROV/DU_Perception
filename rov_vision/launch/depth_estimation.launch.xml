<launch>
  <arg name="param_dir" default="$(find-pkg-share rov_vision)/config"/>
  <arg name="depth_estimation_file" default="depth_estimation.yaml" description="Relative to param_dir"/>

  <node pkg="rov_vision" exec="depth_estimation" name="depth_estimation" output="screen">
    <param from="$(var param_dir)/$(var depth_estimation_file)"/>
  </node>
</launch>
